# SmartPanel — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores

PORT=3000
HOST=http://localhost:3000

# OBRIGATÓRIO: o sistema não inicia sem um JWT_SECRET forte (mínimo 32 caracteres).
# Gere um com:  npm run gerar-secret   e cole a linha completa aqui.
# Nunca compartilhe nem versione este arquivo.
JWT_SECRET=
JWT_EXPIRES=8h

# Opcional: endereço usado no QR Code dos visitantes (ex.: http://192.168.1.13:3000).
# Se ficar vazio, usa o endereço com que o Admin foi aberto; se for localhost, usa o IP da rede local.
# HOST_PUBLICO=
